Grey Wolf Optimizer for Feature Selection (disease detection)
Dataset: breast cancer (tumor malignant / benign), 30 measured features per case.
Each wolf = one on/off choice for every feature.
Requires: numpy, scikit-learn
"""
import numpy as np
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier

np.random.seed(1)

# ------------------------------------------------------------------
# 1. Data: split into train (used by wolves) and test (kept hidden)
# ------------------------------------------------------------------
data = load_breast_cancer()
X, y = data.data, data.target
names = data.feature_names
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=1, stratify=y)

scaler = StandardScaler().fit(X_train)
X_train, X_test = scaler.transform(X_train), scaler.transform(X_test)
N_FEATURES = X.shape[1]

# ------------------------------------------------------------------
# 2. Parameters
# ------------------------------------------------------------------
N_WOLVES = 15
ITERATIONS = 30
PENALTY = 0.02            # cost for using many features

def make_model():
    return KNeighborsClassifier(n_neighbors=5)

# ------------------------------------------------------------------
# 3. Fitness: error + penalty for number of features (lower = better)
#    A wolf is a list of numbers in [0,1]; value > 0.5 means "use this feature"
# ------------------------------------------------------------------
def fitness(wolf):
    mask = wolf > 0.5
    if mask.sum() == 0:
        return 1.0                                   # no features = useless
    acc = cross_val_score(make_model(), X_train[:, mask], y_train, cv=3).mean()
    return (1 - acc) + PENALTY * mask.sum() / N_FEATURES

# ------------------------------------------------------------------
# 4. Initialize wolves randomly
# ------------------------------------------------------------------
wolves = np.random.rand(N_WOLVES, N_FEATURES)
scores = np.array([fitness(w) for w in wolves])

# ------------------------------------------------------------------
# 5-6. Main loop
# ------------------------------------------------------------------
for it in range(ITERATIONS):
    # rank wolves: the 3 best are alpha, beta, delta
    order = np.argsort(scores)
    alpha, beta, delta = (wolves[order[i]].copy() for i in range(3))

    a = 2 - 2 * it / ITERATIONS                      # shrinks from 2 to 0

    for i in range(N_WOLVES):
        new_pos = np.zeros(N_FEATURES)
        for leader in (alpha, beta, delta):
            r1, r2 = np.random.rand(N_FEATURES), np.random.rand(N_FEATURES)
            A = 2 * a * r1 - a
            C = 2 * r2
            D = np.abs(C * leader - wolves[i])       # distance to this leader
            new_pos += leader - A * D                # suggestion from this leader
        wolves[i] = np.clip(new_pos / 3, 0, 1)       # average of the 3 suggestions
        scores[i] = fitness(wolves[i])

    best = scores.min()
    n_used = int((wolves[scores.argmin()] > 0.5).sum())
    print(f"Iter {it + 1:2d} | best fitness = {best:.4f} | features used = {n_used}")

# ------------------------------------------------------------------
# 7. Output: best feature subset, tested on unseen data
# ------------------------------------------------------------------
best_wolf = wolves[scores.argmin()]
mask = best_wolf > 0.5

all_acc = make_model().fit(X_train, y_train).score(X_test, y_test)
sel_acc = make_model().fit(X_train[:, mask], y_train).score(X_test[:, mask], y_test)

print(f"\nSelected {mask.sum()} of {N_FEATURES} features:")
for n in names[mask]:
    print("  -", n)
print(f"\nTest accuracy using ALL {N_FEATURES} features : {all_acc:.3f}")
print(f"Test accuracy using {mask.sum()} selected features : {sel_acc:.3f}")
